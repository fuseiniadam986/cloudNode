[Unit]
Description=CloudNode Panel Beta
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/cloudnode-panel
EnvironmentFile=/etc/cloudnode-panel/env
ExecStart=/opt/cloudnode-panel/.venv/bin/gunicorn -w 1 -b 127.0.0.1:8088 app:app
Restart=on-failure
User=root
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
